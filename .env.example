AGRIFED_DATASET_ROOT=../enfermedadeshoja_v1.0/EnfermedadesHoja_v1.0
AGRIFED_UID=1001
AGRIFED_GID=1001
AGRIFED_PROJECT_EXTRAS=vision,fl,dev,serve,eval
# Optional shared credentials for update ingestion; configure on server and clients.
AGRIFED_AUTH_TOKEN=
AGRIFED_HMAC_KEY=

# Configuracion opcional para offload de entrenamiento a nodo remoto GPU (agrifed-gpu)
# Configurar en el archivo local .env (ignorado por Git): http://<gpu-worker-host>:8089
AGRIFED_GPU_ENDPOINT=
AGRIFED_GPU_WORKER_URL=

# Credenciales semilla opcionales para la Base de Datos de Usuarios (models/users.db)
AGRIFED_ADMIN_USER=admin
AGRIFED_ADMIN_EMAIL=admin@khaos.local
AGRIFED_ADMIN_PASS=
AGRIFED_EXPERT_USER=experto
AGRIFED_EXPERT_EMAIL=experto@khaos.local
AGRIFED_EXPERT_PASS=
AGRIFED_DEFAULT_USER=usuario
AGRIFED_DEFAULT_EMAIL=usuario@khaos.local
AGRIFED_DEFAULT_PASS=

