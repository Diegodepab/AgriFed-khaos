# ==============================================================================
# Dockerfile.gpu - Standalone GPU Compute Worker (agrifed-gpu)
# Optimized for NVIDIA Tesla T4 (CUDA 12.4 / torch==2.6.0+cu124)
# Minimal footprint: Only includes training/detection engine & FastAPI queue worker
# ==============================================================================
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    AGRIFED_WORKSPACE=/workspace \
    YOLO_CONFIG_DIR=/tmp/Ultralytics

WORKDIR /workspace

# Minimal system libraries required for OpenCV/Ultralytics and healthcheck
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# 1. Install PyTorch 2.6.0 + torchvision 0.21.0 with CUDA 12.4 support
RUN pip install --upgrade pip && \
    pip install --index-url https://download.pytorch.org/whl/cu124 \
    torch==2.6.0+cu124 \
    torchvision==0.21.0+cu124

# 2. Copy only the minimal repository files needed for GPU compute
COPY pyproject.toml /workspace/pyproject.toml
COPY src/ /workspace/src/
COPY scripts/ /workspace/scripts/

# 3. Install package core deps (pydantic-settings, numpy, rich: required by agrifed_khaos/__init__)
#    and Ultralytics. torch is already pinned to the CUDA build above, so pip keeps it.
RUN pip install --extra-index-url https://download.pytorch.org/whl/cu124 -e . && \
    pip install --extra-index-url https://download.pytorch.org/whl/cu124 \
    "fastapi>=0.111.0" \
    "uvicorn[standard]>=0.30.0" \
    "pydantic>=2.7.0" \
    "pyyaml>=6.0.1" \
    "httpx>=0.27.0" \
    "pillow>=10.3.0" \
    "python-multipart>=0.0.9" \
    "scikit-learn>=1.5.0" \
    "timm>=1.0.0" \
    "ultralytics>=8.3.0" \
    "opencv-python-headless>=4.9.0" \
    "pydantic-settings>=2.8" \
    "rich>=13.0" \
    "numpy>=1.26"

RUN mkdir -p /workspace/models /workspace/data/gpu_worker_cache

EXPOSE 8088

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -fsS http://localhost:8088/health || exit 1

CMD ["uvicorn", "agrifed_khaos.gpu_worker:app", "--host", "0.0.0.0", "--port", "8088", "--workers", "1"]
